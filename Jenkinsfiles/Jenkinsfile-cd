pipeline {
    agent any

    parameters {
        string(
            name: 'CONFIG_FILE',
            defaultValue: 'project-configs/medical-appointment.yaml',
            description: 'Project YAML configuration path'
        )

        string(
            name: 'REGISTRY',
            defaultValue: 'host.docker.internal:5000',
            description: 'Docker registry address'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Existing image tag to deploy, e.g. build-5'
        )
    }

    stages {

        stage('Checkout Platform Repository') {
            steps {
                checkout scm
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.CONFIG_FILE ==~ /project-configs\/[A-Za-z0-9._-]+\.yaml/)) {
                        error('Invalid CONFIG_FILE path')
                    }

                    if (!(params.REGISTRY ==~ /[A-Za-z0-9.:-]+/)) {
                        error('Invalid registry address')
                    }

                    if (!(params.IMAGE_TAG ==~ /[A-Za-z0-9._-]+/)) {
                        error('IMAGE_TAG is required and must be valid')
                    }
                }
            }
        }

        stage('Validate Project Configuration') {
            steps {
                sh """
                    chmod +x scripts/validate-config.sh
                    ./scripts/validate-config.sh '${params.CONFIG_FILE}'
                """
            }
        }

        stage('Check CD Environment') {
            steps {
                sh """
                    chmod +x scripts/check-cd-environment.sh
                    ./scripts/check-cd-environment.sh '${params.CONFIG_FILE}'
                """
            }
        }

        stage('Load Deployment Configuration') {
            steps {
                script {
                    def configOutput = sh(
                        script: """
                            python3 - <<'PYTHON'
import yaml

with open('${params.CONFIG_FILE}') as file:
    config = yaml.safe_load(file)

deployment = config['deployment']
database = deployment['database']

print(config['container']['imageName'])
print(deployment['namespace'])
print(deployment['name'])
print(deployment['containerName'])
print(deployment['serviceName'])
print(deployment['replicas'])
print(deployment['serviceType'])
print(deployment['servicePort'])
print(deployment['targetPort'])
print(deployment['imagePullSecret'])
print(database['url'])
print(database['username'])
print(database['secretName'])
print(database['passwordKey'])
PYTHON
                        """,
                        returnStdout: true
                    ).trim()

                    def values = configOutput.readLines()

                    env.IMAGE_NAME = values[0]
                    env.NAMESPACE = values[1]
                    env.DEPLOYMENT_NAME = values[2]
                    env.CONTAINER_NAME = values[3]
                    env.SERVICE_NAME = values[4]
                    env.REPLICAS = values[5]
                    env.SERVICE_TYPE = values[6]
                    env.SERVICE_PORT = values[7]
                    env.TARGET_PORT = values[8]
                    env.IMAGE_PULL_SECRET = values[9]
                    env.DB_URL = values[10]
                    env.DB_USERNAME = values[11]
                    env.DB_SECRET_NAME = values[12]
                    env.DB_PASSWORD_KEY = values[13]

                    env.FULL_IMAGE = "${params.REGISTRY}/${env.IMAGE_NAME}:${params.IMAGE_TAG}"

                    echo "Image: ${env.FULL_IMAGE}"
                    echo "Namespace: ${env.NAMESPACE}"
                    echo "Deployment: ${env.DEPLOYMENT_NAME}"
                    echo "Service: ${env.SERVICE_NAME}"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${DEPLOYMENT_NAME}
  namespace: ${NAMESPACE}
spec:
  replicas: ${REPLICAS}
  selector:
    matchLabels:
      app: ${DEPLOYMENT_NAME}
  template:
    metadata:
      labels:
        app: ${DEPLOYMENT_NAME}
    spec:
      imagePullSecrets:
        - name: ${IMAGE_PULL_SECRET}
      containers:
        - name: ${CONTAINER_NAME}
          image: ${FULL_IMAGE}
          imagePullPolicy: Always
          ports:
            - containerPort: ${TARGET_PORT}
          env:
            - name: SPRING_DATASOURCE_URL
              value: "${DB_URL}"
            - name: SPRING_DATASOURCE_USERNAME
              value: "${DB_USERNAME}"
            - name: SPRING_DATASOURCE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ${DB_SECRET_NAME}
                  key: ${DB_PASSWORD_KEY}
---
apiVersion: v1
kind: Service
metadata:
  name: ${SERVICE_NAME}
  namespace: ${NAMESPACE}
spec:
  type: ${SERVICE_TYPE}
  selector:
    app: ${DEPLOYMENT_NAME}
  ports:
    - port: ${SERVICE_PORT}
      targetPort: ${TARGET_PORT}
      protocol: TCP
EOF
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status \
                        deployment/${DEPLOYMENT_NAME} \
                        -n ${NAMESPACE} \
                        --timeout=180s

                    kubectl get deployment ${DEPLOYMENT_NAME} \
                        -n ${NAMESPACE}

                    kubectl get service ${SERVICE_NAME} \
                        -n ${NAMESPACE}

                    kubectl get pods \
                        -n ${NAMESPACE} \
                        -l app=${DEPLOYMENT_NAME}
                '''
            }
        }
        stage('Health Check') {
            steps {
                sh """
                    chmod +x scripts/health-check.sh
                    ./scripts/health-check.sh '${params.CONFIG_FILE}'
                """
            }
        }

    }

    post {
        success {
            echo "CD pipeline completed: ${env.FULL_IMAGE}"
        }

        failure {
            echo 'CD pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Generic Java CD pipeline finished.'
        }
    }
}
